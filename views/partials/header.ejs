<!-- views/partials/header.ejs -->
<!DOCTYPE html>
<html lang="zh-TW">

<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>
    <%= title %>
  </title>

  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="/style.css">
</head>
<nav class="navbar app-navbar fixed-top shadow-sm" style="z-index: 9999;">
  <div class="container-fluid">
    <a class="navbar-brand app-brand" href="<%= isLoggedIn ? '/' : '/login' %>">
      <img src="/image/NCCU_logo.png" class="brand-logo" alt="NCCU Logo">
      <span>政大住宿生洗衣排隊管理系統</span>
    </a>

    <% if (isLoggedIn) { %>
      <div class="d-flex align-items-center gap-2 ms-auto">

        <!-- 通知鈴鐺 -->
        <div class="position-relative">
          <button class="btn btn-outline-secondary notification-btn" type="button" id="notificationBell">
            🔔
            <span id="notificationBadge" class="notification-badge d-none">
              0
            </span>
          </button>

          <div id="notificationBox" class="card shadow position-absolute end-0 mt-2 d-none"
            style="width: 320px; z-index: 10000;">
            <div class="card-header fw-bold">通知紀錄</div>
            <div class="card-body p-2" id="notificationList" style="max-height: 300px; overflow-y: auto;">
              <p class="text-muted mb-0">目前沒有通知</p>
            </div>
          </div>
        </div>

        <!-- 三槓選單 -->
        <button class="navbar-toggler" type="button" data-bs-toggle="offcanvas" data-bs-target="#offcanvasNavbar"
          aria-controls="offcanvasNavbar" aria-label="Toggle navigation">
          <span class="navbar-toggler-icon"></span>
        </button>

      </div>
    <% } %>
  </div>
</nav>

<% if (isLoggedIn) { %>
  <!-- 右側選單，只留一個 offcanvasNavbar -->
  <div class="offcanvas offcanvas-end" tabindex="-1" id="offcanvasNavbar">
    <div class="offcanvas-header">
      <h5 class="offcanvas-title">功能選單</h5>
      <button type="button" class="btn-close" data-bs-dismiss="offcanvas"></button>
    </div>

    <div class="offcanvas-body">
      <ul class="navbar-nav">
        <li class="nav-item">
          <a class="nav-link" href="/penalty">違規紀錄</a>
        </li>
        <li class="nav-item">
          <a class="nav-link" href="/maintenance">設備報修</a>
        </li>
        <li class="nav-item mt-3">
          <button class="logout-link" data-bs-toggle="modal" data-bs-target="#logoutModal">
            登出
          </button>
        </li>
      </ul>
    </div>
  </div>

  <!-- 登出 Modal -->
  <div class="modal fade" id="logoutModal" tabindex="-1">
    <div class="modal-dialog">
      <div class="modal-content">
        <div class="modal-header">
          <h1 class="modal-title fs-5">登出</h1>
          <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
        </div>

        <div class="modal-body">
          <p>是否登出？</p>
        </div>

        <div class="modal-footer">
          <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">取消</button>
          <a href="/logout" class="btn btn-primary">登出</a>
        </div>
      </div>
    </div>
  </div>

  <!-- 洗衣通知 Modal -->
  <div class="modal fade" id="notificationModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
      <div class="modal-content">

        <div class="modal-header">
          <h5 class="modal-title">洗衣提醒</h5>
          <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
        </div>

        <div class="modal-body" id="notificationModalBody">
          洗衣剩餘10秒
        </div>

        <div class="modal-footer">
          <button type="button" class="btn btn-primary" data-bs-dismiss="modal">
            確定
          </button>
        </div>

      </div>
    </div>
  </div>
<% } %>

<body style="padding-top:80px;">
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js"></script>

  <% if (isLoggedIn) { %>
    <script src="/js/notification.js"></script>
  <% } %>