<!-- login.ejs -->
<%- include('partials/header') %>

<div class="login-page">
  <div class="login-card">

    <h2 class="login-title">系統登入 Login</h2>

    <% if (typeof reset !== 'undefined' && reset) { %>
      <div class="alert alert-success py-2 mb-3" role="alert">密碼已重設，請重新登入</div>
    <% } %>
    <% if (typeof error !== 'undefined' && error) { %>
      <div class="alert alert-danger py-2 mb-3" role="alert"><%= error %></div>
    <% } %>

    <form id="login-form" action="/login" method="POST">

      <div class="login-row">
        <label for="email">帳號</label>
        <input 
          type="email" 
          id="email" 
          name="email" 
          placeholder="請輸入 Email"
          required
        >
      </div>

      <div class="login-row">
        <label for="password">密碼</label>
        <input 
          type="password" 
          id="password" 
          name="password" 
          placeholder="請輸入密碼"
          required
        >
      </div>

      <button type="submit" class="login-btn">
        登入
      </button>

      <div style="text-align: right; margin-top: 8px;">
        <a href="/forgot-password" style="font-size: 0.85rem; color: #888;">忘記密碼？</a>
      </div>

    </form>

    <a href="/signup" class="signup-link">
      註冊點這
    </a>

  </div>
</div>

<%- include('partials/footer') %>
