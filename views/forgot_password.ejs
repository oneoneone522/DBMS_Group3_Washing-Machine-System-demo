<%- include('partials/header') %>
    <div class="card" style="width: 22rem;">
      <div class="card-body">
        <h5 class="card-title">忘記密碼</h5>

        <% if (sent) { %>
          <div class="alert alert-success" role="alert">
            如果此 Email 有註冊帳號，重設連結已寄出（請查看您的註冊郵件信箱）。
          </div>
          <a href="/login" class="btn btn-secondary w-100">返回登入</a>
        <% } else { %>
          <p class="text-muted small mb-3">輸入您的 Email，我們將寄送密碼重設連結。</p>
          <form action="/forgot-password" method="POST">
              <div class="mb-3">
                  <label for="email" class="form-label">Email address</label>
                  <input type="email" class="form-control" id="email" name="email" placeholder="name@example.com" required>
              </div>
              <div class="d-flex justify-content-between align-items-center">
                  <button type="submit" class="btn btn-primary">送出</button>
                  <a href="/login" class="text-muted small">返回登入</a>
              </div>
          </form>
        <% } %>
      </div>
    </div>
<%- include('partials/footer') %>
