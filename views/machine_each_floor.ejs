<!-- machine_each_floor.ejs -->
<%- include('partials/header') %>

<div class="container" style="max-width:700px;">
  <a href="/machine" class="btn btn-outline-secondary btn-sm mb-3 mt-2">← 返回機台總覽</a>
  <h1 class="mb-3"><%= Dorm %> <%= floor %> 樓洗衣機使用狀況</h1>
</div>
<div id="floor-btn-container"></div>

<div id="floor-machine-status"></div>
<card id="back-to-index-card"></card>
<script src="/js/checkLogin.js"></script>
<script>
    const currentFloor = '<%= floor %>';
    async function FloorMachineStatus(){
        const response  = await fetch(`/api/machine/floor/${currentFloor}`);
        const floorMachineStatus = await response.json();

        const usageResponse = await fetch('/api/current_usage');
        const currentUsage = await usageResponse.json();
        console.log('Current Usage:', currentUsage);
        const isInUse =  currentUsage && currentUsage.Floor === currentFloor && currentUsage.Usage_Status === 'in_use';
        const floorStatus = {};
        floorMachineStatus.forEach(mStatus => {
            
            const floor = mStatus.Floor;
            if (!floorStatus[floor]) {
                floorStatus[floor] = [];
            }
            floorStatus[floor].push(mStatus);
        });

        const container = document.getElementById('floor-machine-status');
        container.innerHTML = '';
        Object.keys(floorStatus).forEach(floor => {
            const title = document.createElement('h3');
            title.textContent = `${floor} 樓`;
            container.appendChild(title);
            //每台機器一張卡片
            floorStatus[floor].forEach(m => {
                console.log("m: ", m);
                const card = document.createElement('div');
                let machineBtn = '';
                if (isInUse) {
                    machineBtn = `<button disabled>洗衣中</button>`;
                }
                else if (m.in_use === 'busy' && m.Estimated_End_Time && new Date(m.Estimated_End_Time) < new Date()) {
                    // 待取衣狀態：可以先排隊，但不能掃碼
                    machineBtn = `<button id="queue-btn-${m.Machine_ID}" onclick="joinQueue(${m.Machine_ID})">我要排隊</button>`;
                }
                else if (m.Waiting_Queue_Count == 0 && m.in_use === 'idle' && m.Machine_Status === '正常') {
                    machineBtn = `<button id="scan-btn-${m.Machine_ID}" onclick="location.href='/scan_qr?machine_id=${m.Machine_ID}'">掃碼使用</button>`
                }
                else {
                    machineBtn = `<button id="queue-btn-${m.Machine_ID}" onclick="joinQueue(${m.Machine_ID})">我要排隊</button>`;
                }
                card.className = 'machine-card';
                let machineStatusText = m.Machine_Status;
                if (m.Machine_Status === '故障') { 
                    machineStatusText = m.Machine_Status;
                }

                let remainingTimeText = '';
                let isPickupPending = false;
                if (m.in_use === 'busy' && m.Estimated_End_Time) {
                    const remaining = new Date(m.Estimated_End_Time) - new Date();
                    if (remaining > 0) {
                        const mins = Math.floor(remaining / 60000);
                        const secs = Math.floor((remaining % 60000) / 1000);
                        remainingTimeText = `${mins} 分 ${secs} 秒`;
                    } else {
                        // 洗衣已結束，前一位正在取衣
                        isPickupPending = true;
                        const pickupRemaining = new Date(m.Estimated_End_Time).getTime() + 5 * 60 * 1000 - new Date();
                        if (pickupRemaining > 0) {
                            const pm = Math.floor(pickupRemaining / 60000);
                            const ps = Math.floor((pickupRemaining % 60000) / 1000);
                            remainingTimeText = `⏳ 待取衣（${pm}m ${ps}s 後可用）`;
                        } else {
                            remainingTimeText = '⏳ 待取衣（即將釋出）';
                        }
                    }
                } else {
                    remainingTimeText = '目前無人使用';
                }
                card.innerHTML = `
                    <div class="machine-card-header">
                <div>
                   <div class="machine-card-title">${m.Machine_Number} 號機</div>
                  <div class="machine-card-location">${m.Dorm}－${m.Floor}F－${m.Laundry_Room}</div>
                </div>
                    <span class="machine-status-badge ${
                        m.Machine_Status === '故障'
                        ? 'status-danger'
                        : 'status-normal'
                        }">
                     ${machineStatusText}
                    </span>
                </div>

                <div class="machine-card-info">
            <div>
                <div class="info-label">剩餘時間</div>
                <div class="info-value">${remainingTimeText}</div>
            </div>
             <div>
                 <div class="info-label">排隊人數</div>
                 <div class="info-value">${m.Waiting_Queue_Count} 人</div>
            </div>
        </div>

             <div class="machine-card-action">
            ${machineBtn}
        </div>`;
            container.appendChild(card);
            });
        });
    };

    async function joinQueue(machine_id) {
        const btn = document.getElementById(`queue-btn-${machine_id}`);
        btn.disabled = true;
        btn.textContent = "處理中...";

        const response = await fetch(`/api/queue/${machine_id}`, {
            method: 'POST'
        });
        const data = await response.json();

        if (response.ok) {
            alert(data.message); // 只顯示一次 "成功加入排隊"
            btn.textContent = "已登記排隊";
            const card = document.getElementById('back-to-index-card');
            const backBtn = document.createElement('button');
            backBtn.textContent = "回到首頁";
            backBtn.onclick = () => window.location.href = '/';
            card.appendChild(backBtn);
        } else {
            alert(data.message); // 只顯示一次 "你已經在排隊中" 等錯誤原因
            btn.disabled = false;
            btn.textContent = "我要排隊";
        }
    }
    
    async function scanQR(machine_id) {
        const btn = document.getElementById(`scan-btn-${machine_id}`);
        btn.disabled = true;
        btn.textContent= "處理中...";
        if (machine_id) {
            window.location.href = `/scan_qr?machine_id=${machine_id}`;
        }
    }
    async function floorBtn(){
        const response  = await fetch('/api/machine/my-dorm');
        const floorMachineStatus = await response.json();
        const floorStatus = {};
        floorMachineStatus.forEach(mStatus => {
            const floor = mStatus.Floor;
            if(!floorStatus[floor]) {
                floorStatus[floor] = [];
            }
            floorStatus[floor].push(mStatus);
        });

        const currentFloor = window.location.pathname.split('/').pop();
        const container = document.getElementById('floor-btn-container');
        container.innerHTML = '';
        Object.keys(floorStatus).forEach(floor => {
            const btn = document.createElement('button');
            btn.id = `floor-btn-${floor}`;
            btn.onclick = () => {
                window.location.href = `/machine/floor/${floor}`;
            };
            btn.innerHTML = `<p>${floor} 樓</p>`;
            if (floor === currentFloor) {
                btn.className = 'btn btn-primary';
            } 
            else {
                btn.className = 'btn btn-secondary';
            }
            container.appendChild(btn);
        });
    }
    checkLogin();
    FloorMachineStatus();
    floorBtn();
    setInterval(FloorMachineStatus, 5000); // 每 5 秒更新剩餘時間
</script>
<%- include('partials/footer') %>
