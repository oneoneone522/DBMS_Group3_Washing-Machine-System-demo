<%- include('partials/header') %>

<div class="home-page">
  <h2 class="home-title">您的洗衣行程</h2>

  <div class="home-cards">
    <div class="home-section">
      <h4 class="section-label">您正在使用</h4>
      <div class="usage-card" id="usage-container">
        <p class="empty-msg">目前無洗衣行程</p>
      </div>
    </div>

    <div class="home-section">
      <h4 class="section-label">排隊中</h4>
      <div class="usage-card" id="queue-container">
        <p class="empty-msg">目前沒有排隊中的機台</p>
      </div>
    </div>
  </div>

  <div class="home-actions">
    <a href="/machine">
      <button type="button" class="btn-status">查看機台使用狀態</button>
    </a>
  </div>
</div>

<script src="/js/checkLogin.js"></script>
<script>
const just_reserved_machine_id = '<%= just_reserved_machine_id %>';
const machine_id = '<%= machine_id %>';

async function loadUsage() {
  if (just_reserved_machine_id) {
    alert('開始洗衣行程');
  }
  const response = await fetch('/api/current_usage');
  const usage = await response.json();
  const containerUsage = document.getElementById('usage-container');
  if (!usage || usage.machine_id === null) {
    containerUsage.innerHTML = '<p class="empty-msg">目前無洗衣行程</p>';
    return;
  }
  startCountDown(new Date(usage.Estimated_End_Time), containerUsage, usage);
}

async function startCountDown(endsAt, containerUsage, usage) {
  const interval = setInterval(async () => {
    const remaining = endsAt - new Date();
    if (remaining <= 0) {
      clearInterval(interval);
      containerUsage.innerHTML = '<p class="empty-msg">目前無洗衣行程</p>';
      await fetch(`/api/finished/${usage.Usage_ID}`, { method: 'POST' });
      alert('洗衣行程結束！');
      return;
    }
    const m = Math.floor(remaining / 60000);
    const s = Math.floor((remaining % 60000) / 1000);
    containerUsage.innerHTML = `
      <div class="machine-header">
        <div class="machine-number">${usage.Machine_ID} 號機</div>
        <span class="machine-badge">使用中</span>
      </div>
      <div class="machine-location">${usage.Dorm} ${usage.Floor}F - ${usage.Laundry_Room}</div>
      <div class="time-label">剩餘時間</div>
      <div class="time-value">${m} min ${s} sec</div>
    `;
  }, 1000);
}

async function loadQueue() {
  const response = await fetch('/api/my_queue');
  const queue = await response.json();
  const containerQueue = document.getElementById('queue-container');

  if (!queue || (queue.Reservation_Number === "0" && queue.Reservation_Status === 'completed')) {
    containerQueue.innerHTML = '<p class="empty-msg">目前沒有排隊中的機台</p>';
    return;
  }

  let queueBtn = '';
  let alertText = '';
  if (queue.Reservation_Status === 'waiting') {
    if (queue.Reservation_Number === "0") {
      queueBtn = `<button class="btn btn-success" onclick="location.href='/scan_qr?machine_id=${queue.Machine_ID}'">掃碼使用</button>`;
      // 計算剩餘可掃碼時間（Turn_Start_Time + 5 分鐘）
      const deadline = queue.Turn_Start_Time
        ? new Date(new Date(queue.Turn_Start_Time).getTime() + 5 * 60 * 1000)
        : null;
      if (deadline) {
        const msLeft = deadline - new Date();
        if (msLeft > 0) {
          const mLeft = Math.floor(msLeft / 60000);
          const sLeft = Math.floor((msLeft % 60000) / 1000);
          alertText = `輪到您了！請在 ${mLeft}m ${sLeft}s 內掃碼，逾時扣點`;
        } else {
          alertText = '輪到您了！請立即掃碼使用（即將過號）';
        }
      } else {
        alertText = '輪到您了！請於時間內掃碼使用，逾時將取消資格';
      }
    } else {
      queueBtn = `<button class="btn btn-danger" id="cancelBtn" onclick="cancelQueue(${queue.Machine_ID})">取消排隊</button>`;
      alertText = `排隊序號： ${queue.Reservation_Number}`;
    }
  }

  containerQueue.innerHTML = `
    <div class="machine-header">
      <div class="machine-number">${queue.Machine_Number} 號機</div>
      <span class="machine-badge">排隊中</span>
    </div>
    <div class="machine-location">${queue.Dorm} ${queue.Floor}F - ${queue.Laundry_Room}</div>
    <div class="time-label">${alertText}</div>
    ${queueBtn}
  `;
}

async function cancelQueue(machine_id) {
  if (confirm('確定要取消排隊?')) {
    await fetch(`/api/cancel_queue/${machine_id}`, { method: 'POST' });
    alert('已取消排隊');
    loadQueue();
  }
}

loadUsage();
loadQueue();
</script>

<%- include('partials/footer') %>