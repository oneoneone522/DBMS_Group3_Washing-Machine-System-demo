<%- include('partials/header') %>
    <div class="card" style="width: 22rem;">
      <div class="card-body">
        <h5 class="card-title">註冊</h5>

        <% if (typeof error !== 'undefined' && error) { %>
          <div class="alert alert-danger py-2" role="alert"><%= error %></div>
        <% } %>

        <form id="signup-form" action="/signup" method="POST">
            <div class="mb-3">
                <label for="dorm" class="form-label">宿舍</label>
                <select class="form-select" id="dorm" name="dorm" required>
                    <option value="">請選擇宿舍</option>
                </select>
            </div>
            <div class="mb-3">
                <label for="user_name" class="form-label">姓名</label>
                <input class="form-control" type="text" id="user_name" name="user_name" placeholder="請輸入姓名" required>
            </div>
            <div class="mb-3">
                <label for="student_id" class="form-label">學號</label>
                <input class="form-control" type="text" id="student_id" name="student_id" placeholder="請輸入學號" required>
            </div>
            <div class="mb-3">
                <label for="room_number" class="form-label">房號</label>
                <input class="form-control" type="text" id="room_number" name="room_number" placeholder="請輸入房號（如 301）" required>
            </div>
            <div class="mb-3">
                <label for="email" class="form-label">Email</label>
                <input type="email" class="form-control" id="email" name="email" placeholder="name@example.com" required>
            </div>
            <div class="mb-3">
                <label for="password" class="form-label">密碼</label>
                <input class="form-control" type="password" id="password" name="password" placeholder="請輸入密碼" minlength="6" required>
            </div>
            <div class="mb-3">
                <label for="confirm_password" class="form-label">確認密碼</label>
                <input class="form-control" type="password" id="confirm_password" name="confirm_password" placeholder="再輸入一次密碼" minlength="6" required>
            </div>
            <button type="submit" class="btn btn-primary w-100">註冊</button>
            <hr>
            <p class="text-center text-muted small mb-0">已有帳號？<a href="/login">登入</a></p>
        </form>
      </div>
    </div>

    <script>
        async function loadDorms() {
            const response = await fetch('/api/dorm');
            const dorms = await response.json();
            const select = document.getElementById('dorm');
            dorms.forEach(dorm => {
                const option = document.createElement('option');
                option.value = dorm.DORM_NAME;
                option.textContent = dorm.DORM_NAME;
                select.appendChild(option);
            });
        }
        loadDorms();
    </script>
<%- include('partials/footer') %>
